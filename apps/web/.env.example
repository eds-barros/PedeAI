# Base da API, já com o prefixo /api/v1 (sem barra no final).
# A API da Sprint 1 escuta em http://localhost:3000. O web sobe na 3001
# porque o CORS_ORIGIN do backend é http://localhost:3001.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# true inicia o MSW no navegador e dispensa o backend. O padrão é a API real.
NEXT_PUBLIC_API_MOCK=false
