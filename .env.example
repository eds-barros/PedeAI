# Variáveis lidas pela API da Sprint 1 (pacote apps/api, commit af64bab do PR #3).
#
# Quem roda a API fora do Compose copia apps/api/.env.example para apps/api/.env.
# Esse arquivo do pacote prevalece: o ConfigModule lê .env no diretório de trabalho.
# Este arquivo da raiz é o inventário do repositório e repete as mesmas chaves.
#
# Divergência atual: só esta raiz declara SEED_ON_START. O CMD do Dockerfile lê
# essa variável; apps/api/.env.example ainda não a lista. O Compose injeta as
# variáveis do serviço api e não lê nenhum dos dois exemplos.
#
# Valores abaixo são exemplos. Não use estes segredos fora da máquina.

# URL do Postgres. Obrigatória. O schema Prisma usa ?schema=public.
# O exemplo do pacote deixa usuário e senha para preencher.
# Com o Postgres do Compose, na máquina host, use:
# postgresql://pedeai:pedeai@localhost:5432/pedeai?schema=public
# Dentro do container o host é postgres, não localhost.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/pedeai?schema=public

# Segredo do JWT de acesso (HS256). Obrigatório, no mínimo 16 caracteres.
# Lido em validarAmbiente e no JwtModule.
JWT_ACCESS_SECRET=altere-este-segredo-com-16-ou-mais-caracteres

# Duração do access token. Opcional. Padrão no código: 15m.
JWT_ACCESS_TTL=15m

# Validade do refresh token opaco, em dias. Opcional. Padrão no código: 7.
JWT_REFRESH_TTL_DAYS=7

# Origens CORS, separadas por vírgula. Obrigatória (não pode ficar vazia).
# O valor * libera qualquer origem. O Compose usa o frontend local.
CORS_ORIGIN=http://localhost:3001

# Porta HTTP da API. Opcional. Padrão no código: 3000.
PORT=3000

# Nível do logger (pino). Opcional. Padrão no código: info.
LOG_LEVEL=info

# Base do link no texto de redefinição de senha. Opcional.
# Padrão no código: http://localhost:3001
APP_URL=http://localhost:3001

# development, test ou production. Opcional. Padrão no código: development.
# production recusa o seed e usa SMTP. test usa o adaptador de e-mail em memória.
# development escreve o e-mail no log.
NODE_ENV=development

# Teto de logins falhos por IP e e-mail na janela. Opcional. Padrão no código: 5.
# O Compose e o .env.example do pacote usam 50 em desenvolvimento.
LOGIN_MAX_FALHAS_EMAIL=50

# Teto de logins falhos por IP na janela. Opcional. Padrão no código: 20.
# O Compose e o .env.example do pacote usam 200 em desenvolvimento.
LOGIN_MAX_FALHAS_IP=200

# Janela do rate limit de login, em minutos. Opcional. Padrão no código: 15.
# O contador fica em memória, numa instância só.
LOGIN_JANELA_MIN=15

# Lida só pelo CMD do Dockerfile (não pelo Nest). true roda `prisma db seed`
# depois do `migrate deploy`. O Compose define "true". Seed recusa production.
SEED_ON_START=true

# SMTP. Lidas só com NODE_ENV=production (adaptador smtp).
# Sem SMTP_HOST o envio é ignorado e um aviso vai para o log.
# SMTP_PORT padrão 587. SMTP_SECURE=true liga TLS direto.
# SMTP_FROM padrão nao-responda@pedeai.local.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=nao-responda@pedeai.local
