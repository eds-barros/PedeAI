// Schema canônico do PedeAI. Fica em apps/api/prisma para ir junto com o pacote.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  ADMIN
  GERENTE
  CAIXA
  GARCOM
  COZINHA
}

enum StatusPedido {
  ABERTO
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO
  PAGO
}

enum TipoPedido {
  BALCAO
  MESA
  DELIVERY
}

enum StatusCaixa {
  ABERTO
  FECHADO
}

enum TipoMovimentoCaixa {
  VENDA
  SANGRIA
  SUPRIMENTO
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CREDITO
  DEBITO
}

model Empresa {
  id            String   @id @default(uuid()) @db.Uuid
  razaoSocial   String   @map("razao_social")
  nomeFantasia  String   @map("nome_fantasia")
  slug          String   @unique
  cnpj          String?  @unique
  telefone      String?
  email         String?
  endereco      String?
  logoUrl       String?  @map("logo_url")
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  vinculos        UsuarioEmpresa[]
  usuariosUltimos Usuario[]            @relation("UltimaEmpresa")
  sessoes         Sessao[]
  categorias      Categoria[]
  produtos        Produto[]
  pedidos         Pedido[]
  caixas          Caixa[]

  @@map("empresas")
}

model Usuario {
  id               String   @id @default(uuid()) @db.Uuid
  nome             String
  email            String   @unique
  senhaHash        String   @map("senha_hash")
  ativo            Boolean  @default(true)
  ultimaEmpresaId  String?  @map("ultima_empresa_id") @db.Uuid
  criadoEm         DateTime @default(now()) @map("criado_em")
  atualizadoEm     DateTime @updatedAt @map("atualizado_em")

  ultimaEmpresa Empresa?                 @relation("UltimaEmpresa", fields: [ultimaEmpresaId], references: [id])
  vinculos      UsuarioEmpresa[]
  sessoes       Sessao[]
  refreshTokens RefreshToken[]
  tokensReset   TokenRedefinicaoSenha[]
  pedidos       Pedido[]
  caixas        Caixa[]

  @@map("usuarios")
}

model UsuarioEmpresa {
  id           String   @id @default(uuid()) @db.Uuid
  usuarioId    String   @map("usuario_id") @db.Uuid
  empresaId    String   @map("empresa_id") @db.Uuid
  papel        Papel
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, empresaId])
  @@index([empresaId])
  @@map("usuarios_empresas")
}

/// Família de refresh de um login/dispositivo. sid no JWT é este id.
model Sessao {
  id             String    @id @default(uuid()) @db.Uuid
  usuarioId      String    @map("usuario_id") @db.Uuid
  empresaAtivaId String    @map("empresa_ativa_id") @db.Uuid
  revogadaEm     DateTime? @map("revogada_em")
  criadoEm       DateTime  @default(now()) @map("criado_em")

  usuario      Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresaAtiva Empresa        @relation(fields: [empresaAtivaId], references: [id])
  tokens       RefreshToken[]

  @@index([usuarioId])
  @@map("sessoes")
}

model RefreshToken {
  id               String    @id @default(uuid()) @db.Uuid
  usuarioId        String    @map("usuario_id") @db.Uuid
  sessaoId         String    @map("sessao_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash")
  accessJti        String    @map("access_jti")
  expiraEm         DateTime  @map("expira_em")
  revogadoEm       DateTime? @map("revogado_em")
  substituidoPorId String?   @map("substituido_por_id") @db.Uuid
  criadoEm         DateTime  @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sessao  Sessao  @relation(fields: [sessaoId], references: [id], onDelete: Cascade)

  @@index([sessaoId])
  @@index([usuarioId])
  @@map("refresh_tokens")
}

model TokenRedefinicaoSenha {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiraEm  DateTime  @map("expira_em")
  usadoEm   DateTime? @map("usado_em")
  criadoEm  DateTime  @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("tokens_redefinicao_senha")
}

model Categoria {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @map("empresa_id") @db.Uuid
  nome         String
  ordem        Int      @default(0)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa  Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  produtos Produto[]

  @@unique([empresaId, nome])
  @@map("categorias")
}

model Produto {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String   @map("empresa_id") @db.Uuid
  categoriaId  String?  @map("categoria_id") @db.Uuid
  nome         String
  descricao    String?
  preco        Decimal  @db.Decimal(10, 2)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa  Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  categoria Categoria?  @relation(fields: [categoriaId], references: [id])
  itens    ItemPedido[]

  @@unique([empresaId, nome])
  @@index([empresaId])
  @@map("produtos")
}

model Pedido {
  id           String       @id @default(uuid()) @db.Uuid
  empresaId    String       @map("empresa_id") @db.Uuid
  usuarioId    String?      @map("usuario_id") @db.Uuid
  numero       Int
  status       StatusPedido @default(ABERTO)
  tipo         TipoPedido   @default(BALCAO)
  observacao   String?
  subtotal     Decimal      @default(0) @db.Decimal(10, 2)
  desconto     Decimal      @default(0) @db.Decimal(10, 2)
  total        Decimal      @default(0) @db.Decimal(10, 2)
  criadoEm     DateTime     @default(now()) @map("criado_em")
  atualizadoEm DateTime     @updatedAt @map("atualizado_em")

  empresa    Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario    Usuario?         @relation(fields: [usuarioId], references: [id])
  itens      ItemPedido[]
  movimentos MovimentoCaixa[]

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@map("pedidos")
}

model ItemPedido {
  id            String  @id @default(uuid()) @db.Uuid
  pedidoId      String  @map("pedido_id") @db.Uuid
  produtoId     String  @map("produto_id") @db.Uuid
  quantidade    Int
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)
  observacao    String?
  total         Decimal @db.Decimal(10, 2)

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@map("itens_pedido")
}

model Caixa {
  id              String      @id @default(uuid()) @db.Uuid
  empresaId       String      @map("empresa_id") @db.Uuid
  usuarioId       String      @map("usuario_id") @db.Uuid
  status          StatusCaixa @default(ABERTO)
  valorAbertura   Decimal     @map("valor_abertura") @db.Decimal(10, 2)
  valorFechamento Decimal?    @map("valor_fechamento") @db.Decimal(10, 2)
  abertoEm        DateTime    @default(now()) @map("aberto_em")
  fechadoEm       DateTime?   @map("fechado_em")
  observacao      String?

  empresa    Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario    Usuario          @relation(fields: [usuarioId], references: [id])
  movimentos MovimentoCaixa[]

  @@index([empresaId])
  @@map("caixas")
}

model MovimentoCaixa {
  id             String             @id @default(uuid()) @db.Uuid
  caixaId        String             @map("caixa_id") @db.Uuid
  pedidoId       String?            @map("pedido_id") @db.Uuid
  tipo           TipoMovimentoCaixa
  formaPagamento FormaPagamento?    @map("forma_pagamento")
  valor          Decimal            @db.Decimal(10, 2)
  descricao      String?
  criadoEm       DateTime           @default(now()) @map("criado_em")

  caixa  Caixa   @relation(fields: [caixaId], references: [id], onDelete: Cascade)
  pedido Pedido? @relation(fields: [pedidoId], references: [id])

  @@map("movimentos_caixa")
}
