# Copie para backend/.env. Valores abaixo são placeholders, não segredos reais.
# O docker-compose da raiz define as variáveis do serviço api.

# Postgres local (ajuste usuário, senha e banco)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/pedeai?schema=public

# Segredo do JWT de acesso. Mínimo de 16 caracteres. Troque em qualquer ambiente compartilhado.
JWT_ACCESS_SECRET=altere-este-segredo-com-16-ou-mais-caracteres
# TTL do access token. Padrão da Sprint 1: 15 minutos.
JWT_ACCESS_TTL=15m
# TTL do refresh token opaco, em dias.
JWT_REFRESH_TTL_DAYS=7

# Origens do frontend, separadas por vírgula. Use * só em desenvolvimento.
CORS_ORIGIN=http://localhost:3001

PORT=3000
LOG_LEVEL=info
# URL usada no texto do e-mail de redefinição de senha.
APP_URL=http://localhost:3001

# SMTP só é usado com NODE_ENV=production. Em development o envio vai para o log.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=nao-responda@pedeai.local

# development | test | production. Seed recusa production.
NODE_ENV=development

# Rate limit do login. Conta só tentativas falhas. O store é em memória
# (vale para uma instância; Redis fica para depois). Em desenvolvimento
# os tetos são folgados para não travar o uso local.
LOGIN_MAX_FALHAS_EMAIL=50
LOGIN_MAX_FALHAS_IP=200
LOGIN_JANELA_MIN=15
